; spi_monitor.pio
;
; Passive SPI bus monitor using PIO.
;
; Captures MOSI and MISO simultaneously on every active SCK edge.
; Works for CPOL=0/CPHA=0 (sample on rising SCK) by default.
; The C driver can invert the clock wait condition for other modes.
;
; Pins (in order, assigned at runtime):
;   pin 0 = MOSI
;   pin 1 = MISO
;   pin 2 = SCK
;   pin 3 = CS (optional – used to frame bytes)
;
; State machine 0: sample MOSI+MISO on SCK rising edge
; State machine 1: CS framing detector

; ---------------------------------------------------------------------------
; SM0 – sample MOSI and MISO on every SCK rising edge
; ---------------------------------------------------------------------------
.program spi_monitor_data
.wrap_target
    wait 0 gpio 2          ; wait SCK low  (pin 2 = SCK)
    wait 1 gpio 2          ; wait SCK high (rising edge)
    in   pins, 2           ; sample MOSI(bit0) + MISO(bit1) into ISR
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void spi_monitor_data_program_init(
        PIO pio, uint sm, uint offset,
        uint mosi_pin, uint miso_pin, uint sck_pin) {
    pio_sm_config c = spi_monitor_data_program_get_default_config(offset);

    pio_gpio_init(pio, mosi_pin);
    pio_gpio_init(pio, miso_pin);
    pio_gpio_init(pio, sck_pin);

    /* IN base = mosi_pin; assumes mosi, miso are consecutive */
    sm_config_set_in_pins(&c, mosi_pin);

    /* Autopush every 16 bits: 8 pairs of (MOSI,MISO) bits = 1 byte each */
    sm_config_set_in_shift(&c, false, true, 16);

    sm_config_set_clkdiv(&c, 1.0f);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}

; ---------------------------------------------------------------------------
; SM1 – CS (chip-select) framing detector
;
; Pushes 0x00 when CS goes LOW  (frame start)
; Pushes 0xFF when CS goes HIGH (frame end)
; ---------------------------------------------------------------------------
.program spi_monitor_cs
.wrap_target
    wait 0 gpio 3           ; wait for CS low  (frame start)
    in   null, 8            ; push 0x00
    push noblock
    wait 1 gpio 3           ; wait for CS high (frame end)
    in   null, 8            ; push 0xFF temporarily
    ; push 0xFF by inverting: set x 0 / not x / mov isr x
    mov  x, ~null
    mov  isr, x
    push noblock
.wrap

% c-sdk {
static inline void spi_monitor_cs_program_init(
        PIO pio, uint sm, uint offset, uint cs_pin) {
    pio_sm_config c = spi_monitor_cs_program_get_default_config(offset);

    pio_gpio_init(pio, cs_pin);
    sm_config_set_in_pins(&c, cs_pin);
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_clkdiv(&c, 1.0f);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
